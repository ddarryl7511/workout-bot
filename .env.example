# Discord Bot Token
# Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database
# With docker-compose, leave the default below as-is.
DATABASE_URL=postgresql://workout_bot:password123@postgres:5432/workout_bot

# Ollama (local LLM that powers the coaching responses)
# With docker-compose, leave OLLAMA_HOST as-is. The bundled ollama service
# is reachable at http://ollama:11434.
# If you run Ollama yourself instead, point this at it, e.g.
#   http://localhost:11434       (Ollama on the same machine, no Docker)
#   http://192.168.1.50:11434    (Ollama on another box / homelab)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Optional: only used by docker-compose for the bundled Postgres container.
# Keep these in sync with DATABASE_URL above if you change them.
DB_USER=workout_bot
DB_PASSWORD=password123
DB_NAME=workout_bot
